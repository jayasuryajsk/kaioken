{
  "name": "@kaioken/server",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node ../../scripts/build-node-entry.mjs src/index.ts dist/index.js --clean-dist --external ./start-server.js --copy-dir ../../packages/db/drizzle dist/drizzle --copy-dir src/assets dist/assets && node --import tsx scripts/copy-builtin-skills.ts && node ../../scripts/build-node-entry.mjs src/start-server.ts dist/start-server.js && node ../../scripts/build-node-entry.mjs ../../packages/plugin-sdk/src/index.ts dist/plugin-sdk-runtime.js",
    "start": "node dist/index.js",
    "start:prod": "cross-env NODE_ENV=production node dist/index.js",
    "dev": "node --conditions=source --import tsx scripts/dev-supervisor.mjs",
    "clean": "rimraf dist",
    "generate:bb-official-marketplace": "node --conditions=source --import tsx scripts/generate-bb-official-marketplace.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:provider-corpus": "vitest run --config vitest.config.ts test/provider-corpus"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.6.23",
    "@better-auth/drizzle-adapter": "^1.6.23",
    "@earendil-works/pi-ai": "0.84.0",
    "@get-kaioken/plugin-sdk": "workspace:*",
    "@hono/node-server": "^1.19.11",
    "@hono/node-ws": "^1.3.0",
    "@kaioken/codex-rollout": "workspace:*",
    "@kaioken/config": "workspace:*",
    "@kaioken/core-ui": "workspace:*",
    "@kaioken/db": "workspace:*",
    "@kaioken/domain": "workspace:*",
    "@kaioken/host-daemon-contract": "workspace:*",
    "@kaioken/logger": "workspace:*",
    "@kaioken/plugin-build": "workspace:*",
    "@kaioken/process-utils": "workspace:*",
    "@kaioken/sdk": "workspace:*",
    "@kaioken/secret-storage": "workspace:*",
    "@kaioken/server-contract": "workspace:*",
    "@kaioken/templates": "workspace:*",
    "@kaioken/thread-view": "workspace:*",
    "@kaioken/tunnel-contract": "workspace:*",
    "@opentelemetry/api": "1.9.1",
    "better-auth": "^1.6.23",
    "better-sqlite3": "12.10.0",
    "cron-parser": "^5.5.0",
    "drizzle-orm": "^0.38.4",
    "gray-matter": "^4.0.3",
    "hono": "^4.7.0",
    "jiti": "^2.6.1",
    "mime-types": "^3.0.2",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "pino-roll": "^4.0.0",
    "semver": "^7.7.0",
    "ws": "^8.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@kaioken/agent-runtime": "workspace:*",
    "@kaioken/client-core": "workspace:*",
    "@kaioken/scripts": "workspace:*",
    "@kaioken/test-helpers": "workspace:*",
    "@kaioken/tsconfig": "workspace:*",
    "@types/better-sqlite3": "^7.6.12",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^22.0.0",
    "@types/semver": "^7.7.0",
    "@types/ws": "^8.18.1",
    "ajv": "8.20.0",
    "tsx": "^4.23.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "vitest": "^4.1.1",
    "ws": "^8.19.0"
  }
}
