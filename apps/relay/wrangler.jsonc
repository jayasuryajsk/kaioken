{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kaioken-relay",
  "account_id": "aacfaf92d9e6e1ac5904dfc1769b1283",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "workers_dev": false,
  "routes": [
    { "pattern": "kaioken.app", "custom_domain": true },
    { "pattern": "studio.kaioken.app", "custom_domain": true },
    { "pattern": "*.kaioken.app/*", "zone_name": "kaioken.app" },
  ],
  "vars": { "BASE_DOMAIN": "kaioken.app", "HANDLE": "studio" },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TunnelDO"] },
    { "tag": "v2", "new_sqlite_classes": ["PairingLimiter"] },
    { "tag": "v3", "new_sqlite_classes": ["AccountDO"] },
    { "tag": "v4", "new_sqlite_classes": ["LoginDO"] },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "TUNNEL_DO", "class_name": "TunnelDO" },
      { "name": "PAIRING_LIMITER", "class_name": "PairingLimiter" },
      { "name": "ACCOUNT_DO", "class_name": "AccountDO" },
      { "name": "LOGIN_DO", "class_name": "LoginDO" },
    ],
  },
  "kv_namespaces": [
    { "binding": "STATE", "id": "4189fe88541a44c7828f06ee4b9b9934" },
  ],
}
