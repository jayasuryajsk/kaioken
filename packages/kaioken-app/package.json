{
  "name": "kaioken-app",
  "version": "1.0.9",
  "description": "kaioken app launcher for npx",
  "keywords": [
    "kaioken",
    "coding-agent",
    "agent",
    "cli",
    "workspace",
    "codex",
    "claude-code"
  ],
  "homepage": "https://github.com/get-bb/bb#readme",
  "bugs": {
    "url": "https://github.com/get-bb/bb/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/get-bb/bb.git",
    "directory": "packages/kaioken-app"
  },
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/public-sdk.ts",
      "types": "./dist/index.d.ts",
      "node": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./dist/kaioken-app.js": "./dist/kaioken-app.js"
  },
  "types": "./dist/index.d.ts",
  "os": [
    "darwin",
    "linux"
  ],
  "bin": {
    "kaioken-app": "dist/kaioken-app.js",
    "kaioken": "dist/kaioken.js",
    "kaioken-server": "dist/kaioken-server.js",
    "kaioken-host-daemon": "dist/kaioken-host-daemon.js"
  },
  "files": [
    "app/dist",
    "dist",
    "!dist/*.map",
    "host-daemon/dist/kaioken",
    "host-daemon/dist/kaioken-chunks",
    "host-daemon/dist/kaioken-parcel-watcher-child.mjs",
    "host-daemon/dist/kaioken-plugin-host-worker.mjs",
    "host-daemon/dist/kaioken-provider-bridge-worker.mjs",
    "host-daemon/dist/daemon-bundle.mjs",
    "server/dist",
    "!server/dist/index.js.map",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:host": "node scripts/build-host.mjs",
    "clean": "rimraf dist app host-daemon server tsconfig.tsbuildinfo",
    "prepack": "node dist/prune-kaioken-chunks.mjs",
    "smoke:tarball": "node scripts/smoke-tarball.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@parcel/watcher": "2.5.6",
    "better-sqlite3": "12.10.0",
    "hono": "^4.7.0",
    "jiti": "^2.6.1",
    "node-pty": "1.2.0-beta.15",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "pino-roll": "^4.0.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@kaioken/config": "workspace:*",
    "@kaioken/sdk": "workspace:*",
    "@kaioken/tsconfig": "workspace:*",
    "@types/node": "^22.0.0",
    "rimraf": "^6.1.0",
    "rollup": "^4.62.2",
    "rollup-plugin-dts": "^6.4.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "vitest": "^4.1.1"
  },
  "engines": {
    "node": "^22.19.0 || ^24.0.0 || ^26.0.0"
  }
}
