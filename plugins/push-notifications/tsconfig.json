{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "esModuleInterop": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@get-kaioken/plugin-sdk": [
        "../../packages/plugin-sdk/bundled-types/kaioken-plugin-sdk.d.ts"
      ],
      "@get-kaioken/plugin-sdk/testing": [
        "../../packages/plugin-sdk/bundled-types/kaioken-plugin-sdk-testing.d.ts"
      ],
      "@get-kaioken/plugin-sdk/app": [
        "../../packages/plugin-sdk/bundled-types/kaioken-plugin-sdk-app.d.ts"
      ],
      "@get-kaioken/plugin-sdk/testing/app": [
        "../../packages/plugin-sdk/bundled-types/kaioken-plugin-sdk-testing-app.d.ts"
      ]
    },
    "jsx": "react-jsx"
  },
  "include": ["*.ts", "*.tsx"]
}
