{
  "extends": ["//"],
  "tasks": {
    "typecheck": {
      "dependsOn": ["@get-kaioken/plugin-sdk#build:types"]
    },
    "build": {
      "dependsOn": ["@get-kaioken/plugin-sdk#build:types", "@kaioken/cli#build"],
      "cache": false
    },
    "test": {
      "dependsOn": ["@get-kaioken/plugin-sdk#build:types"],
      "cache": false
    },
    "smoke": {
      "cache": false,
      "dependsOn": ["@get-kaioken/plugin-sdk#build:types"],
      "passThroughEnv": ["DEV_BROWSER_SMOKE_BINARY", "DEV_BROWSER_SMOKE_CHROME"]
    },
    "smoke:install": {
      "cache": false,
      "dependsOn": ["@get-kaioken/plugin-sdk#build:types"],
      "passThroughEnv": ["DEV_BROWSER_SMOKE_CHROME"]
    }
  }
}
